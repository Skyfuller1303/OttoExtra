+    foreach (['rollback-1', 'rollback-2'] as $key) { $insert->execute([$key, 'Synthetic', 'Keep', '2020-01-01', '2020-01-01']); }
+    $pdo->exec("CREATE TRIGGER rp_qa_fail BEFORE UPDATE ON external_participants FOR EACH ROW BEGIN
+        IF OLD.entity_key = 'rollback-2' AND NEW.rp_name IS NULL THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'synthetic rollback'; END IF; END");
