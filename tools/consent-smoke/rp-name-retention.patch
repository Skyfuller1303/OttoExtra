diff --git "a/OttoRegions Web/includes/rp_name_retention.php" "b/OttoRegions Web/includes/rp_name_retention.php"
--- /dev/null
+++ "b/OttoRegions Web/includes/rp_name_retention.php"
@@ -0,0 +1,142 @@
+<?php
+
+declare(strict_types=1);
+
+/** Retention of RP-name mappings only; does not delete imported player accounts. */
+function rpNameTableExists(PDO $pdo, string $table): bool
+{
+    $stmt = $pdo->prepare('SELECT 1 FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = ?');
+    $stmt->execute([$table]);
+    return (bool) $stmt->fetchColumn();
+}
+
+function rpNameEnsureRetentionSchema(PDO $pdo): void
+{
+    if (!rpNameTableExists($pdo, 'external_participants')) {
+        return;
+    }
+    $columns = $pdo->query('SHOW COLUMNS FROM external_participants')->fetchAll(PDO::FETCH_COLUMN);
+    if (!in_array('rp_name', $columns, true)) {
+        return;
+    }
+    if (!in_array('rp_name_expires_at', $columns, true)) {
+        try {
+            $pdo->exec('ALTER TABLE external_participants ADD COLUMN rp_name_expires_at DATETIME NULL');
+        } catch (PDOException $error) {
+            // Another request may have added the same column during startup.
+            $fresh = $pdo->query('SHOW COLUMNS FROM external_participants')->fetchAll(PDO::FETCH_COLUMN);
+            if (!in_array('rp_name_expires_at', $fresh, true)) {
+                throw $error;
+            }
+        }
+    }
+    $indexes = $pdo->query('SHOW INDEX FROM external_participants')->fetchAll(PDO::FETCH_ASSOC);
+    if (!in_array('idx_rp_name_expiry', array_column($indexes, 'Key_name'), true)) {
+        try {
+            $pdo->exec('CREATE INDEX idx_rp_name_expiry ON external_participants (rp_name_expires_at)');
+        } catch (PDOException $error) {
+            $fresh = $pdo->query('SHOW INDEX FROM external_participants')->fetchAll(PDO::FETCH_ASSOC);
+            if (!in_array('idx_rp_name_expiry', array_column($fresh, 'Key_name'), true)) {
+                throw $error;
+            }
+        }
+    }
+}
+
+/** Only an explicit RP-name write renews the term, never a read or ordinary player sync. */
+function rpNameStore(PDO $pdo, string $entityKey, ?string $name): void
+{
+    $stmt = $pdo->prepare('UPDATE external_participants
+        SET rp_name = :name,
+            rp_name_expires_at = CASE WHEN :has_name = 1 THEN DATE_ADD(UTC_TIMESTAMP(), INTERVAL 6 MONTH) ELSE NULL END
+        WHERE entity_key = :entity_key');
+    $stmt->execute([':name' => $name, ':has_name' => $name !== null ? 1 : 0, ':entity_key' => $entityKey]);
+}
+
+/**
+ * Bounded, transactional batches. UTC calendar months (including month-end clamping).
+ * Legacy mappings with no provenance date receive six months from their first cleanup.
+ * Dry runs neither backfill dates nor delete data. Schema changes must precede this call.
+ */
+function rpNameCleanup(PDO $pdo, bool $apply = false, ?DateTimeImmutable $asOf = null, int $batchSize = 500, int $maxBatches = 20): array
+{
+    if ($pdo->inTransaction()) {
+        throw new LogicException('RP retention must run outside an existing transaction.');
+    }
+    if ($batchSize < 1 || $batchSize > 1000 || $maxBatches < 1 || $maxBatches > 100) {
+        throw new InvalidArgumentException('Invalid RP retention batch limits.');
+    }
+    $asOf = ($asOf ?? new DateTimeImmutable('now', new DateTimeZone('UTC')))->setTimezone(new DateTimeZone('UTC'));
+    $sessionZone = (string) $pdo->query('SELECT @@session.time_zone')->fetchColumn();
+    try {
+        // TIMESTAMP log columns must be compared to the same UTC clock as DATETIME expiry.
+        $pdo->exec("SET time_zone = '+00:00'");
+        return rpNameCleanupUtc($pdo, $apply, $asOf, $batchSize, $maxBatches);
+    } finally {
+        $pdo->exec('SET time_zone = ' . $pdo->quote($sessionZone));
+    }
+}
+
+function rpNameCleanupUtc(PDO $pdo, bool $apply, DateTimeImmutable $asOf, int $batchSize, int $maxBatches): array
+{
+    $now = $asOf->format('Y-m-d H:i:s');
+    $jobs = [];
+    if (rpNameTableExists($pdo, 'external_participants')) {
+        $jobs['legacy_initialized'] = [
+            'external_participants', 'rp_name IS NOT NULL AND rp_name_expires_at IS NULL',
+            'UPDATE external_participants SET rp_name_expires_at = DATE_ADD(:migration_now, INTERVAL 6 MONTH)',
+            [':migration_now' => $now], [],
+        ];
+        $jobs['names_expired'] = [
+            'external_participants', 'rp_name_expires_at <= :cutoff',
+            'UPDATE external_participants SET rp_name = NULL, rp_name_expires_at = NULL',
+            [':cutoff' => $now], [':cutoff' => $now],
+        ];
+    }
+    foreach (['changes_deleted' => 'external_participant_rp_name_log', 'requests_deleted' => 'external_participant_rp_name_request_log'] as $key => $table) {
+        if (rpNameTableExists($pdo, $table)) {
+            $jobs[str_replace('_deleted', '_initialized', $key)] = [
+                $table, 'created_at IS NULL', 'UPDATE ' . $table . ' SET created_at = :migration_now',
+                [':migration_now' => $now], [],
+            ];
+            // The indexed bound narrows the scan; DATE_ADD implements exact calendar months.
+            $where = 'created_at <= :candidate AND DATE_ADD(created_at, INTERVAL 6 MONTH) <= :cutoff';
+            $params = [':candidate' => $asOf->modify('-5 months')->format('Y-m-d H:i:s'), ':cutoff' => $now];
+            $jobs[$key] = [$table, $where, 'DELETE FROM ' . $table, $params, $params];
+        }
+    }
+    $result = ['as_of_utc' => $now, 'apply' => $apply, 'legacy_initialized' => 0,
+        'names_expired' => 0, 'changes_initialized' => 0, 'requests_initialized' => 0,
+        'changes_deleted' => 0, 'requests_deleted' => 0, 'remaining' => []];
+    foreach ($jobs as $key => [$table, $where, $mutation, $params, $countParams]) {
+        $count = $pdo->prepare('SELECT COUNT(*) FROM ' . $table . ' WHERE ' . $where);
+        $count->execute($countParams);
+        $available = (int) $count->fetchColumn();
+        if (!$apply) {
+            $result[$key] = $available;
+            continue;
+        }
+        $stmt = $pdo->prepare($mutation . ' WHERE ' . $where . ' LIMIT ' . $batchSize);
+        for ($batch = 0; $batch < $maxBatches && $available > 0; $batch++) {
+            $pdo->beginTransaction();
+            try {
+                $stmt->execute($params);
+                $changed = $stmt->rowCount();
+                $pdo->commit();
+            } catch (Throwable $error) {
+                if ($pdo->inTransaction()) {
+                    $pdo->rollBack();
+                }
+                throw $error;
+            }
+            $result[$key] += $changed;
+            $available -= $changed;
+            if ($changed < $batchSize) {
+                break;
+            }
+        }
+        $count->execute($countParams);
+        $result['remaining'][$key] = (int) $count->fetchColumn();
+    }
+    return $result;
+}
diff --git "a/OttoRegions Web/tools/rp-name-retention.php" "b/OttoRegions Web/tools/rp-name-retention.php"
--- /dev/null
+++ "b/OttoRegions Web/tools/rp-name-retention.php"
@@ -0,0 +1,29 @@
+<?php
+
+declare(strict_types=1);
+
+if (PHP_SAPI !== 'cli') {
+    http_response_code(404);
+    exit;
+}
+
+$arguments = array_slice($argv, 1);
+if (array_diff($arguments, ['--apply', '--dry-run']) !== []
+    || (in_array('--apply', $arguments, true) && in_array('--dry-run', $arguments, true))) {
+    fwrite(STDERR, "Usage: php tools/rp-name-retention.php [--dry-run|--apply]\n");
+    exit(2);
+}
+// Bootstrap includes the existing database configuration and additive schema migration.
+// Default mode previews counts; it never initializes dates or deletes RP content.
+require_once __DIR__ . '/../includes/bootstrap.php';
+if (!$pdo instanceof PDO) {
+    fwrite(STDERR, "Database connection unavailable.\n");
+    exit(1);
+}
+try {
+    $result = rpNameCleanup($pdo, in_array('--apply', $arguments, true));
+    echo json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . PHP_EOL;
+} catch (Throwable $error) {
+    fwrite(STDERR, 'RP retention failed: ' . $error->getMessage() . PHP_EOL);
+    exit(1);
+}
diff --git "a/OttoRegions Web/tools/rp-name-retention-selftest.php" "b/OttoRegions Web/tools/rp-name-retention-selftest.php"
--- /dev/null
+++ "b/OttoRegions Web/tools/rp-name-retention-selftest.php"
@@ -0,0 +1,114 @@
+<?php
+
+declare(strict_types=1);
+if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
+require_once __DIR__ . '/../includes/rp_name_retention.php';
+
+// Explicit disposable loopback databases only; never read the project's .env.
+$port = (int) ($argv[1] ?? 33317);
+if (!in_array($port, [33316, 33317], true)) { throw new RuntimeException('QA loopback port required'); }
+$pdo = new PDO("mysql:host=127.0.0.1;port={$port};charset=utf8mb4", 'root', 'local-qa-only', [
+    PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_EMULATE_PREPARES => false,
+]);
+$database = 'ottoextra_rp_qa_' . getmypid();
+$pdo->exec('CREATE DATABASE `' . $database . '`');
+$pdo->exec('USE `' . $database . '`');
+$pdo->exec("SET time_zone = '+00:00'");
+$passed = 0;
+function check(bool $ok, string $message): void {
+    global $passed;
+    if (!$ok) { throw new RuntimeException($message); }
+    echo 'ok: ' . $message . PHP_EOL;
+    $passed++;
+}
+function at(string $time): DateTimeImmutable { return new DateTimeImmutable($time, new DateTimeZone('UTC')); }
+function value(PDO $pdo, string $key, string $column = 'rp_name_expires_at'): mixed {
+    if (!in_array($column, ['rp_name_expires_at', 'rp_name', 'name'], true)) { throw new LogicException('Column'); }
+    $stmt = $pdo->prepare('SELECT ' . $column . ' FROM external_participants WHERE entity_key = ?');
+    $stmt->execute([$key]);
+    return $stmt->fetchColumn();
+}
+try {
+    $pdo->exec('CREATE TABLE external_participants (entity_key VARCHAR(191) PRIMARY KEY,
+        name VARCHAR(120), rp_name VARCHAR(120), last_seen_at DATETIME) ENGINE=InnoDB');
+    foreach (['external_participant_rp_name_log', 'external_participant_rp_name_request_log'] as $table) {
+        $pdo->exec('CREATE TABLE ' . $table . ' (id BIGINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
+            created_at TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP, payload_json TEXT) ENGINE=InnoDB');
+    }
+    $pdo->exec("INSERT INTO external_participants VALUES ('legacy', 'Account', 'Old RP', '2026-09-11')");
+    rpNameEnsureRetentionSchema($pdo);
+    rpNameEnsureRetentionSchema($pdo);
+    check(value($pdo, 'legacy', 'rp_name') === 'Old RP', 'Schema migration preserves existing names');
+    check(value($pdo, 'legacy') === null, 'Schema migration does not invent an observation time');
+    $now = at('2026-09-11 12:00:00');
+    $dry = rpNameCleanup($pdo, false, $now);
+    check($dry['legacy_initialized'] === 1 && value($pdo, 'legacy') === null, 'Dry run leaves content and dates untouched');
+    rpNameCleanup($pdo, true, $now);
+    check(value($pdo, 'legacy') === '2027-03-11 12:00:00', 'Unknown legacy age receives six calendar months');
+    rpNameCleanup($pdo, true, at('2026-09-12 12:00:00'));
+    check(value($pdo, 'legacy') === '2027-03-11 12:00:00', 'Repeated cleanup never renews the legacy grace period');
+    rpNameStore($pdo, 'legacy', 'New RP');
+    check(value($pdo, 'legacy', 'rp_name') === 'New RP', 'Explicit name writes work');
+    $seconds = (int) $pdo->query("SELECT ABS(TIMESTAMPDIFF(SECOND, rp_name_expires_at, DATE_ADD(UTC_TIMESTAMP(), INTERVAL 6 MONTH))) FROM external_participants WHERE entity_key = 'legacy'")->fetchColumn();
+    check($seconds <= 2, 'Explicit name write sets a six-calendar-month deadline');
+    rpNameStore($pdo, 'legacy', null);
+    check(value($pdo, 'legacy') === null && value($pdo, 'legacy', 'rp_name') === null, 'Manual deletion is possible before six months');
+
+    $insert = $pdo->prepare('INSERT INTO external_participants (entity_key, name, rp_name, rp_name_expires_at, last_seen_at) VALUES (?, ?, ?, ?, ?)');
+    $insert->execute(['expired', 'Preserve Account', 'Expired RP', '2026-09-11 12:00:00', '2030-01-01']);
+    $insert->execute(['fresh', 'Fresh Account', 'Fresh RP', '2026-09-11 12:00:01', '2026-09-11']);
+    $pdo->exec("SET time_zone = '+02:00'");
+    $clean = rpNameCleanup($pdo, true, $now);
+    check($clean['names_expired'] === 1, 'Deadline equality expires only the eligible mapping');
+    check(value($pdo, 'expired', 'name') === 'Preserve Account', 'Player account fields survive RP expiry');
+    check(value($pdo, 'fresh', 'rp_name') === 'Fresh RP', 'A mapping one second younger remains');
+    check($pdo->query('SELECT @@session.time_zone')->fetchColumn() === '+02:00', 'Caller session time zone is restored');
+    $pdo->exec("SET time_zone = '+00:00'");
+
+    foreach (['external_participant_rp_name_log', 'external_participant_rp_name_request_log'] as $table) {
+        $pdo->exec("INSERT INTO {$table} (created_at,payload_json) VALUES
+            ('2026-08-31 10:00:00','expired'),('2026-08-31 10:00:01','fresh'),(NULL,'undated')");
+    }
+    $pdo->exec("SET time_zone = '+02:00'");
+    $preview = rpNameCleanup($pdo, false, at('2027-02-28 10:00:00'));
+    check($preview['changes_deleted'] === 1 && $preview['requests_deleted'] === 1, 'Month-end preview uses exact UTC calendar months');
+    $clean = rpNameCleanup($pdo, true, at('2027-02-28 10:00:00'));
+    check($clean['changes_deleted'] === 1 && $clean['requests_deleted'] === 1, 'Both logs expire at the clamped February deadline');
+    check($clean['changes_initialized'] === 1 && $clean['requests_initialized'] === 1, 'Undated logs get a dated grace period');
+    $pdo->exec("SET time_zone = '+00:00'");
+    check((int) $pdo->query("SELECT COUNT(*) FROM external_participant_rp_name_log WHERE payload_json = 'fresh'")->fetchColumn() === 1, 'Newer history survives cleanup');
+    $pdo->exec("INSERT INTO external_participant_rp_name_log (created_at) VALUES ('2023-08-31 10:00:00')");
+    check(rpNameCleanup($pdo, false, at('2024-02-29 09:59:59'))['changes_deleted'] === 0, 'Leap-day boundary does not delete early');
+    check(rpNameCleanup($pdo, true, at('2024-02-29 10:00:00'))['changes_deleted'] === 1, 'Leap-year February has the correct deadline');
+
+    for ($i = 0; $i < 501; $i++) {
+        $insert->execute(['batch-' . $i, 'Synthetic', 'RP', '2020-01-01', '2030-01-01']);
+        $pdo->exec("INSERT INTO external_participant_rp_name_request_log (created_at) VALUES ('2020-01-01')");
+    }
+    $limited = rpNameCleanup($pdo, true, $now, 500, 1);
+    check($limited['names_expired'] === 500 && $limited['remaining']['names_expired'] === 1, 'Bounded name batch reports remaining work');
+    check($limited['requests_deleted'] === 500 && $limited['remaining']['requests_deleted'] === 1, 'Bounded request batch reports remaining work');
+    $rest = rpNameCleanup($pdo, true, $now);
