{
  "schemaVersion": 1,
  "id": "ottoextra",
  "version": "${version}",
  "name": "OttoExtra",
  "description": "Client conveniences for Ottonien: maps, regions, roleplay names, letters and chat channels. Optional downloads and online services require informed consent.",
  "authors": [
    "Skyfuller1303"
  ],
  "contact": {
    "homepage": "https://github.com/Skyfuller1303/OttoExtra",
    "sources": "https://github.com/Skyfuller1303/OttoExtra",
    "issues": "https://github.com/Skyfuller1303/OttoExtra/issues"
  },
  "license": "MIT",
  "icon": "assets/ottoextra/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "de.ottoextra.OttoExtraClient",
      "de.ottoextra.resources.OttoExtraResourcesClient",
      "de.ottoextra.tacticalfactions.TacticalFactionsClient"
    ],
    "ottoextra": [
      "de.ottoextra.resources.OttoExtraResourcesAddon",
      "de.ottoextra.tacticalfactions.TacticalFactionsAddon"
    ],
    "modmenu": [
      "de.ottoextra.config.OttoExtraModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "ottoextra.mixins.json",
      "environment": "client"
    },
    {
      "config": "ottoextra_resources.mixins.json",
      "environment": "client"
    },
    {
      "config": "ottoextra_tacticalfactions.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.4+1.21.11"
  },
  "breaks": {
    "ottoextra_resources": "*",
    "ottoextra_tacticalfactions": "*"
  },
  "suggests": {
    "modmenu": "*",
    "litematica": "*",
    "xaerominimap": "*",
    "xaeroworldmap": "*"
  },
  "custom": {
    "modmenu": {
      "update_checker": false
    }
  }
}
